{{ 'glocket-sections.css' | asset_url | stylesheet_tag }}

{% style %}
  #GlocketReviews-{{ section.id }} {
    --glocket-pad-top: {{ section.settings.padding_top }}px;
    --glocket-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div
  id="GlocketReviews-{{ section.id }}"
  class="glocket-section glocket-reviews color-{{ section.settings.color_scheme }} gradient"
>
  <div class="glocket-section__inner">
    <div class="glocket-reviews__header">
      {% if section.settings.heading != blank %}
        <h2 class="glocket-heading glocket-reviews__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.rating_summary != blank %}
        <p class="glocket-reviews__rating">{{ section.settings.rating_summary | escape }}</p>
      {% endif %}
      {% if section.settings.supporting_text != blank %}
        <div class="glocket-reviews__supporting rte">{{ section.settings.supporting_text }}</div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="glocket-reviews__items">
        {% for block in section.blocks %}
          <article class="glocket-reviews__card" {{ block.shopify_attributes }}>
            {% if block.settings.rating_text != blank %}
              <p class="glocket-reviews__card-rating">{{ block.settings.rating_text | escape }}</p>
            {% endif %}
            {% if block.settings.quote != blank %}
              <blockquote class="glocket-reviews__quote">
                <p>{{ block.settings.quote | escape }}</p>
              </blockquote>
            {% endif %}
            <footer class="glocket-reviews__author">
              {% if block.settings.avatar != blank %}
                {{
                  block.settings.avatar
                  | image_url: width: 160
                  | image_tag:
                    class: 'glocket-reviews__avatar',
                    loading: 'lazy',
                    sizes: '56px',
                    widths: '56, 80, 112, 160'
                }}
              {% endif %}
              {% if block.settings.author != blank %}
                <cite>{{ block.settings.author | escape }}</cite>
              {% endif %}
            </footer>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Glocket reviews",
  "tag": "section",
  "class": "section-glocket-reviews",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What customers are saying"
    },
    {
      "type": "text",
      "id": "rating_summary",
      "label": "Rating summary",
      "default": "Customer rating summary"
    },
    {
      "type": "richtext",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "<p>Add a short introduction to your customer reviews.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Add a customer review."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating text",
          "default": "Customer rating"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glocket reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
