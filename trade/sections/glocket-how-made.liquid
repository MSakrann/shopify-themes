{% comment %}
  GLOCKET — "How It's Made" Process Section
  Mirrors Vinia's "How VINIA Is Made" 4-step section with image + text cards.
{% endcomment %}

<style>
  .glocket-process {
    background: #fff;
    padding: 80px 20px;
  }

  .glocket-process__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .glocket-process__header {
    text-align: center;
    margin-bottom: 54px;
  }

  .glocket-process__heading {
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 800;
    color: #111;
    margin: 0 0 12px;
  }

  .glocket-process__subheading {
    font-size: 16px;
    color: #666;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .glocket-process__steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    position: relative;
  }

  @media (max-width: 900px) {
    .glocket-process__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .glocket-process__steps {
      grid-template-columns: 1fr;
    }
  }

  /* Connector line between steps */
  .glocket-process__steps::before {
    content: '';
    position: absolute;
    top: 48px;
    left: 12%;
    right: 12%;
    height: 2px;
    background: linear-gradient(to right, #ddd, #111, #ddd);
    z-index: 0;
  }

  @media (max-width: 900px) {
    .glocket-process__steps::before { display: none; }
  }

  .glocket-process__step {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .glocket-process__step-num {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    font-size: 18px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }

  .glocket-process__step-img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
    margin-bottom: 16px;
    background: #f3f3f3;
  }

  .glocket-process__step-img-placeholder {
    width: 100%;
    padding-bottom: 100%;
    background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
    border-radius: 12px;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
  }

  .glocket-process__step-img-placeholder::after {
    content: attr(data-emoji);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
  }

  /* Workaround since ::after can't use content from attr for flex */
  .glocket-process__step-emoji {
    font-size: 52px;
    display: block;
    margin-bottom: 16px;
  }

  .glocket-process__step-title {
    font-size: 15px;
    font-weight: 700;
    color: #111;
    margin: 0 0 8px;
  }

  .glocket-process__step-text {
    font-size: 13px;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }
</style>

<section class="glocket-process" id="glocket-process">
  <div class="glocket-process__inner">

    <div class="glocket-process__header">
      <h2 class="glocket-process__heading">{{ section.settings.heading }}</h2>
      <p class="glocket-process__subheading">{{ section.settings.subheading }}</p>
    </div>

    <div class="glocket-process__steps">

      <div class="glocket-process__step">
        <div class="glocket-process__step-num">1</div>
        {% if section.settings.step_1_image %}
          <img class="glocket-process__step-img"
            src="{{ section.settings.step_1_image | image_url: width: 400 }}"
            alt="{{ section.settings.step_1_title }}"
            loading="lazy" width="400" height="400">
        {% else %}
          <span class="glocket-process__step-emoji">🍇</span>
        {% endif %}
        <h3 class="glocket-process__step-title">{{ section.settings.step_1_title }}</h3>
        <p class="glocket-process__step-text">{{ section.settings.step_1_text }}</p>
      </div>

      <div class="glocket-process__step">
        <div class="glocket-process__step-num">2</div>
        {% if section.settings.step_2_image %}
          <img class="glocket-process__step-img"
            src="{{ section.settings.step_2_image | image_url: width: 400 }}"
            alt="{{ section.settings.step_2_title }}"
            loading="lazy" width="400" height="400">
        {% else %}
          <span class="glocket-process__step-emoji">⚙️</span>
        {% endif %}
        <h3 class="glocket-process__step-title">{{ section.settings.step_2_title }}</h3>
        <p class="glocket-process__step-text">{{ section.settings.step_2_text }}</p>
      </div>

      <div class="glocket-process__step">
        <div class="glocket-process__step-num">3</div>
        {% if section.settings.step_3_image %}
          <img class="glocket-process__step-img"
            src="{{ section.settings.step_3_image | image_url: width: 400 }}"
            alt="{{ section.settings.step_3_title }}"
            loading="lazy" width="400" height="400">
        {% else %}
          <span class="glocket-process__step-emoji">🔬</span>
        {% endif %}
        <h3 class="glocket-process__step-title">{{ section.settings.step_3_title }}</h3>
        <p class="glocket-process__step-text">{{ section.settings.step_3_text }}</p>
      </div>

      <div class="glocket-process__step">
        <div class="glocket-process__step-num">4</div>
        {% if section.settings.step_4_image %}
          <img class="glocket-process__step-img"
            src="{{ section.settings.step_4_image | image_url: width: 400 }}"
            alt="{{ section.settings.step_4_title }}"
            loading="lazy" width="400" height="400">
        {% else %}
          <span class="glocket-process__step-emoji">📦</span>
        {% endif %}
        <h3 class="glocket-process__step-title">{{ section.settings.step_4_title }}</h3>
        <p class="glocket-process__step-text">{{ section.settings.step_4_text }}</p>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Glocket How It's Made",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "How Glocket Is Made" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Precision engineered for durability, grip, and everyday life." },
    { "type": "image_picker", "id": "step_1_image", "label": "Step 1 Image" },
    { "type": "text", "id": "step_1_title", "label": "Step 1 Title", "default": "Premium Silicon Sourced" },
    { "type": "textarea", "id": "step_1_text", "label": "Step 1 Text", "default": "We use medical-grade, food-safe silicon for maximum flexibility and safety." },
    { "type": "image_picker", "id": "step_2_image", "label": "Step 2 Image" },
    { "type": "text", "id": "step_2_title", "label": "Step 2 Title", "default": "Precision Molding" },
    { "type": "textarea", "id": "step_2_text", "label": "Step 2 Text", "default": "Each Glocket is injection-molded to exact tolerances for a perfect suction cup shape." },
    { "type": "image_picker", "id": "step_3_image", "label": "Step 3 Image" },
    { "type": "text", "id": "step_3_title", "label": "Step 3 Title", "default": "Stress-Tested Suction" },
    { "type": "textarea", "id": "step_3_text", "label": "Step 3 Text", "default": "Every unit is tested for hold strength, surface adhesion, and release smoothness." },
    { "type": "image_picker", "id": "step_4_image", "label": "Step 4 Image" },
    { "type": "text", "id": "step_4_title", "label": "Step 4 Title", "default": "Card Pocket Assembly" },
    { "type": "textarea", "id": "step_4_text", "label": "Step 4 Text", "default": "The card compartment is heat-sealed for a snug, rattle-free fit that holds your cards securely." }
  ]
}
{% endschema %}
