{{ 'nomad-sections.css' | asset_url | stylesheet_tag }}

{% style %}
  #NomadReviews-{{ section.id }} {
    --nomad-pad-top: {{ section.settings.padding_top }}px;
    --nomad-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div
  id="NomadReviews-{{ section.id }}"
  class="nomad-section nomad-reviews color-{{ section.settings.color_scheme }} gradient"
>
  <div class="nomad-section__inner">
    <div class="nomad-reviews__summary">
      {% if section.settings.heading != blank %}
        <h2 class="nomad-heading nomad-reviews__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.rating_text != blank %}
        <p class="nomad-reviews__rating">{{ section.settings.rating_text | escape }}</p>
      {% endif %}
      {% if section.settings.reviews_count_text != blank %}
        <p class="nomad-reviews__count">{{ section.settings.reviews_count_text | escape }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="nomad-reviews__items">
        {% for block in section.blocks %}
          <article
            class="nomad-reviews__card nomad-card color-{{ section.settings.card_color_scheme }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image != blank %}
              <div class="nomad-reviews__media nomad-media">
                {{
                  block.settings.image
                  | image_url: width: 160
                  | image_tag:
                    class: 'nomad-reviews__avatar',
                    loading: 'lazy',
                    sizes: '56px',
                    widths: '56, 80, 112, 160'
                }}
              </div>
            {% endif %}
            {% if block.settings.rating_text != blank %}
              <p class="nomad-reviews__card-rating">{{ block.settings.rating_text | escape }}</p>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="nomad-reviews__card-title">{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <div class="nomad-reviews__card-body nomad-body">{{ block.settings.body }}</div>
            {% endif %}
            {% if block.settings.author != blank %}
              <footer class="nomad-reviews__author">
                <cite>{{ block.settings.author | escape }}</cite>
              </footer>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Nomad reviews",
  "tag": "section",
  "class": "section-nomad-reviews",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What customers are saying"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.9 / 5"
    },
    {
      "type": "text",
      "id": "reviews_count_text",
      "label": "Reviews count text",
      "default": "Based on customer reviews"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating text",
          "default": "5 / 5"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Review title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Add a short customer review about how Glocket keeps cables organized.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nomad reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author": "Alex M.",
            "rating_text": "5 / 5",
            "title": "Clips cleanly to MagSafe",
            "body": "<p>Glocket stays put on my MagSafe and keeps the cable tip ready when I sit down at my desk.</p>"
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Jordan K.",
            "rating_text": "5 / 5",
            "title": "Finally organized cables",
            "body": "<p>I keep USB-C and Lightning parked in one place. Desk clutter dropped overnight.</p>"
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Sam R.",
            "rating_text": "4 / 5",
            "title": "Solid everyday carry",
            "body": "<p>Small enough for a bag, strong enough that the cable tip does not wander when I travel.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
