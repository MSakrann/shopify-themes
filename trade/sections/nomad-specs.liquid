{{ 'nomad-sections.css' | asset_url | stylesheet_tag }}

{% style %}
  #NomadSpecs-{{ section.id }} {
    --nomad-pad-top: {{ section.settings.padding_top }}px;
    --nomad-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div
  id="NomadSpecs-{{ section.id }}"
  class="nomad-section nomad-specs color-{{ section.settings.color_scheme }} gradient"
>
  <div class="nomad-section__inner">
    <div class="nomad-card color-{{ section.settings.card_color_scheme }} nomad-specs__card">
      {% if section.settings.heading != blank %}
        <h2 class="nomad-heading nomad-specs__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="nomad-specs__accordion nomad-accordion">
          {% for block in section.blocks %}
            <div class="nomad-specs__item" {{ block.shopify_attributes }}>
              {% render 'nomad-accordion',
                heading: block.settings.heading,
                content: block.settings.content,
                open: block.settings.open
              %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nomad specs",
  "tag": "section",
  "class": "section-nomad-specs",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "More info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Spec group",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Design"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<ul><li>Compact silicone body that grips desks and nightstands</li><li>Open channel keeps cables visible and ready to grab</li><li>Soft edges and a low profile that stays out of the way</li></ul>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nomad specs",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "heading": "Design",
            "content": "<ul><li>Compact silicone body that grips desks and nightstands</li><li>Open channel keeps cables visible and ready to grab</li><li>Soft edges and a low profile that stays out of the way</li></ul>",
            "open": true
          }
        },
        {
          "type": "group",
          "settings": {
            "heading": "Technical",
            "content": "<ul><li>Fits common USB-C, Lightning, and MagSafe cable tips</li><li>Non-slip base for wood, glass, and painted surfaces</li><li>Easy to wipe clean; indoor use only</li></ul>",
            "open": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
