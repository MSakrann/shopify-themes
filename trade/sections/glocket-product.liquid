{{ 'glocket-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'glocket-product.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'glocket-product-form-' | append: section.id
  assign social_proof = section.blocks | where: 'type', 'social_proof' | first
  assign trust_badge = section.blocks | where: 'type', 'trust_badge' | first
-%}

{% style %}
  #GlocketProduct-{{ section.id }} {
    --glocket-pad-top: {{ section.settings.padding_top }}px;
    --glocket-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div
  id="GlocketProduct-{{ section.id }}"
  class="glocket-product color-{{ section.settings.color_scheme }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-add-to-cart-label="{{ section.settings.add_to_cart_label | escape }}"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
>
  <div class="glocket-product__layout page-width">
    <div class="glocket-product__media">
      {% render 'glocket-gallery', product: product, section: section %}
      {% render 'glocket-accordion', blocks: section.blocks %}
    </div>

    <div class="glocket-product__info{% if section.settings.enable_sticky_info %} glocket-product__info--sticky{% endif %}">
      {% if social_proof %}
        {% if social_proof.settings.link != blank %}
          <a
            class="glocket-product__social-proof glocket-product__social-proof--link"
            href="{{ social_proof.settings.link }}"
            {{ social_proof.shopify_attributes }}
          >
        {% else %}
          <div class="glocket-product__social-proof" {{ social_proof.shopify_attributes }}>
        {% endif %}
          <span class="glocket-product__stars" aria-hidden="true">★★★★★</span>
          {% if social_proof.settings.rating_text != blank %}
            <span>{{ social_proof.settings.rating_text }}</span>
          {% endif %}
          {% if social_proof.settings.reviews_text != blank %}
            <span>{{ social_proof.settings.reviews_text }}</span>
          {% endif %}
          {% if social_proof.settings.customers_text != blank %}
            <span>{{ social_proof.settings.customers_text }}</span>
          {% endif %}
        {% if social_proof.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endif %}

      <h1 class="glocket-product__title">{{ product.title }}</h1>

      {% if trust_badge %}
        <div class="glocket-product__trust-badge" {{ trust_badge.shopify_attributes }}>
          {% if trust_badge.settings.icon %}
            {{
              trust_badge.settings.icon
              | image_url: width: 96
              | image_tag: class: 'glocket-product__trust-badge-icon', loading: 'lazy', widths: '48,72,96'
            }}
          {% endif %}
          <div>
            {% if trust_badge.settings.heading != blank %}
              <p class="glocket-product__trust-badge-heading">{{ trust_badge.settings.heading }}</p>
            {% endif %}
            {% if trust_badge.settings.text != blank %}
              <p class="glocket-product__trust-badge-text">{{ trust_badge.settings.text }}</p>
            {% endif %}
            {% if trust_badge.settings.link != blank and trust_badge.settings.link_label != blank %}
              <a href="{{ trust_badge.settings.link }}" class="glocket-product__trust-badge-link">
                {{- trust_badge.settings.link_label -}}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if section.settings.description_override != blank %}
        <div class="glocket-product__description rte">{{ section.settings.description_override }}</div>
      {% elsif section.settings.use_product_description and product.description != blank %}
        <div class="glocket-product__description rte">{{ product.description }}</div>
      {% endif %}

      <div class="glocket-product__bullets">
        {% for block in section.blocks %}
          {% if block.type == 'bullet' %}
            <div class="glocket-product__bullet" {{ block.shopify_attributes }}>
              {% if block.settings.icon %}
                {{
                  block.settings.icon
                  | image_url: width: 64
                  | image_tag: class: 'glocket-product__bullet-icon', loading: 'lazy', widths: '32,48,64'
                }}
              {% else %}
                <span class="glocket-product__bullet-check" aria-hidden="true">✓</span>
              {% endif %}
              <span>{{ block.settings.text }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% render 'glocket-variant-tiles',
        product: product,
        product_form_id: product_form_id,
        variant_heading: section.settings.variant_heading
      %}

      <product-form class="glocket-product__form product-form" data-section-id="{{ section.id }}">
        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <span class="product-form__error-message"></span>
        </div>

        {% form 'product',
          product,
          id: product_form_id,
          class: 'form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        %}
          <input
            type="hidden"
            name="id"
            value="{{ current_variant.id }}"
            class="product-variant-id"
            data-glocket-variant-id
          >

          <div class="glocket-product__quantity">
            <label for="GlocketQuantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
            <input
              id="GlocketQuantity-{{ section.id }}"
              class="glocket-product__quantity-input"
              type="number"
              name="quantity"
              min="{{ current_variant.quantity_rule.min | default: 1 }}"
              step="{{ current_variant.quantity_rule.increment | default: 1 }}"
              value="{{ current_variant.quantity_rule.min | default: 1 }}"
            >
          </div>

          <div class="glocket-product__price price">
            <span class="glocket-product__price-current price-item price-item--regular" data-glocket-price>
              {{- current_variant.price | money -}}
            </span>
            <s
              class="glocket-product__price-compare price-item price-item--sale"
              data-glocket-compare
              {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}
            >
              {{- current_variant.compare_at_price | money -}}
            </s>
          </div>

          <div class="glocket-product__buttons product-form__buttons">
            <button
              type="submit"
              name="add"
              class="glocket-product__atc product-form__submit button button--full-width button--primary"
              data-glocket-atc
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-glocket-atc-label>
                {% if current_variant.available %}
                  {{ section.settings.add_to_cart_label }}
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </span>
              {% render 'loading-spinner' %}
            </button>
            {% if section.settings.show_dynamic_checkout %}
              {{ form | payment_button }}
            {% endif %}
          </div>
        {% endform %}
      </product-form>

      <div class="glocket-product__trust-row">
        {% for block in section.blocks %}
          {% if block.type == 'trust_item' %}
            <div class="glocket-product__trust-item" {{ block.shopify_attributes }}>
              {% if block.settings.icon %}
                {{
                  block.settings.icon
                  | image_url: width: 64
                  | image_tag: class: 'glocket-product__trust-item-icon', loading: 'lazy', widths: '32,48,64'
                }}
              {% endif %}
              <span>{{ block.settings.label }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Glocket product",
  "tag": "section",
  "class": "section-glocket-product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Sticky product info on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_product_description",
      "label": "Use product description",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description_override",
      "label": "Description override"
    },
    {
      "type": "text",
      "id": "variant_heading",
      "label": "Variant picker heading",
      "default": "Choose your color"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Buy it now",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "social_proof",
      "name": "Social proof",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating text",
          "default": "4.7/5.0"
        },
        {
          "type": "text",
          "id": "reviews_text",
          "label": "Reviews text",
          "default": "0 Reviews"
        },
        {
          "type": "text",
          "id": "customers_text",
          "label": "Customers text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Trusted quality"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Add your proof claim here."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "bullet",
      "name": "Bullet",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Benefit point"
        }
      ]
    },
    {
      "type": "accordion_item",
      "name": "Accordion row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add details here.</p>"
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust row item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glocket product"
    }
  ]
}
{% endschema %}
