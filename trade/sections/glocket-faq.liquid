{{ 'glocket-sections.css' | asset_url | stylesheet_tag }}

{% style %}
  #GlocketFaq-{{ section.id }} {
    --glocket-pad-top: {{ section.settings.padding_top }}px;
    --glocket-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div
  id="GlocketFaq-{{ section.id }}"
  class="glocket-section glocket-faq color-{{ section.settings.color_scheme }} gradient"
>
  <div class="glocket-section__inner glocket-faq__inner">
    {% if section.settings.heading != blank %}
      <h2 class="glocket-heading glocket-faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="glocket-faq__items">
        {% for block in section.blocks %}
          <details class="glocket-faq__item" {{ block.shopify_attributes }}>
            <summary class="glocket-faq__summary">
              <span>{{ block.settings.question | escape }}</span>
              <span class="glocket-faq__icon" aria-hidden="true"></span>
            </summary>
            {% if block.settings.answer != blank %}
              <div class="glocket-faq__answer rte">{{ block.settings.answer }}</div>
            {% endif %}
          </details>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Glocket FAQ",
  "tag": "section",
  "class": "section-glocket-faq",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Add a frequently asked question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add a clear and helpful answer.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glocket FAQ",
      "blocks": [
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        },
        {
          "type": "faq_item"
        }
      ]
    }
  ]
}
{% endschema %}
