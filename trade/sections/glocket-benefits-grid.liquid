{{ 'glocket-sections.css' | asset_url | stylesheet_tag }}

{% style %}
  #GlocketBenefitsGrid-{{ section.id }} {
    --glocket-pad-top: {{ section.settings.padding_top }}px;
    --glocket-pad-bottom: {{ section.settings.padding_bottom }}px;
    --glocket-benefits-columns: {{ section.settings.columns_desktop }};
  }
{% endstyle %}

<div
  id="GlocketBenefitsGrid-{{ section.id }}"
  class="glocket-section glocket-benefits-grid color-{{ section.settings.color_scheme }} gradient"
>
  <div class="glocket-section__inner">
    {% if section.settings.heading != blank %}
      <h2 class="glocket-heading glocket-benefits-grid__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="glocket-benefits-grid__items">
      {% for block in section.blocks %}
        <article class="glocket-benefits-grid__card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            {{
              block.settings.icon
              | image_url: width: 240
              | image_tag:
                class: 'glocket-benefits-grid__icon',
                loading: 'lazy',
                sizes: '80px',
                widths: '80, 120, 160, 240'
            }}
          {% endif %}
          {% if block.settings.title != blank %}
            <h3 class="glocket-benefits-grid__title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="glocket-benefits-grid__text rte">{{ block.settings.text }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Glocket benefits grid",
  "tag": "section",
  "class": "section-glocket-benefits-grid",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Benefits for everyday life"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "3"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Explain this product benefit in a short, useful sentence.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glocket benefits grid",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}
