{{ 'glocket-sections.css' | asset_url | stylesheet_tag }}

{% style %}
  #GlocketStatsProof-{{ section.id }} {
    --glocket-pad-top: {{ section.settings.padding_top }}px;
    --glocket-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div
  id="GlocketStatsProof-{{ section.id }}"
  class="glocket-section glocket-stats-proof color-{{ section.settings.color_scheme }} gradient"
>
  <div class="glocket-section__inner">
    <div class="glocket-stats-proof__lead{% if section.settings.image == blank %} glocket-stats-proof__lead--without-media{% endif %}">
      <div class="glocket-stats-proof__content">
        {% if section.settings.heading != blank %}
          <h2 class="glocket-heading glocket-stats-proof__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <div class="glocket-body glocket-stats-proof__body rte">{{ section.settings.body }}</div>
        {% endif %}
        {% if section.settings.cta_label != blank %}
          <a
            class="glocket-btn"
            {% if section.settings.cta_link == blank %}
              role="link"
              aria-disabled="true"
            {% else %}
              href="{{ section.settings.cta_link }}"
            {% endif %}
          >
            {{ section.settings.cta_label | escape }}
          </a>
        {% endif %}
      </div>

      {% if section.settings.image != blank %}
        <div class="glocket-stats-proof__media">
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              class: 'glocket-stats-proof__image',
              loading: 'lazy',
              sizes: '(min-width: 990px) 44vw, 100vw',
              widths: '375, 550, 750, 1100, 1500, 1600'
          }}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="glocket-stats-proof__stats">
        {% for block in section.blocks %}
          <div class="glocket-stats-proof__stat" {{ block.shopify_attributes }}>
            {% if block.settings.value != blank %}
              <p class="glocket-stats-proof__value">{{ block.settings.value | escape }}</p>
            {% endif %}
            {% if block.settings.label != blank %}
              <h3 class="glocket-stats-proof__label">{{ block.settings.label }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="glocket-stats-proof__text">{{ block.settings.text | escape }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Glocket stats proof",
  "tag": "section",
  "class": "section-glocket-stats-proof",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Proof you can see"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Add a concise claim and the context that supports it.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "00%"
        },
        {
          "type": "inline_richtext",
          "id": "label",
          "label": "Label",
          "default": "Stat label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Add a short explanation of this result."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glocket stats proof",
      "blocks": [
        {
          "type": "stat"
        },
        {
          "type": "stat"
        },
        {
          "type": "stat"
        }
      ]
    }
  ]
}
{% endschema %}
