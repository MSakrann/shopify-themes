{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "disabled": true,
      "custom_css": [
        "* {text-align: center; margin-top: 10px;}"
      ],
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "color_scheme": "scheme-1"
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "custom_css": [
        "* {text-align: center; font-family: \"ClashDisplay-Medium\";}",
        ".button--full-width {display: inline; width: 90%;}",
        ".quick-add__submit {padding: 0.8rem; min-width: 90%; box-sizing: border-box;}",
        ".price-item--regular {color: #E75A0E; font-size: 15px;}"
      ],
      "settings": {
        "products_per_page": 20,
        "columns_desktop": 4,
        "columns_mobile": "1",
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "standard",
        "enable_filtering": true,
        "filter_type": "drawer",
        "enable_sorting": true,
        "padding_top": 0,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "banner",
    "product-grid"
  ]
}
