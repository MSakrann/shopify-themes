{% comment %}
  GLOCKET — Feature Highlights Section
  Mirrors Vinia's scrolling feature carousel with icon + label + description.
  Also includes the certification badges strip (like Vinia's NO BPA / KETO / etc.)
{% endcomment %}

<style>
  .glocket-features {
    background: #fff;
    padding: 80px 20px;
    overflow: hidden;
  }

  .glocket-features__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .glocket-features__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .glocket-features__heading {
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 800;
    color: #111;
    margin: 0 0 12px;
  }

  .glocket-features__subheading {
    font-size: 16px;
    color: #666;
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── Scrolling carousel ── */
  .glocket-features__carousel-wrap {
    position: relative;
  }

  .glocket-features__carousel {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 12px;
  }

  .glocket-features__carousel::-webkit-scrollbar { display: none; }

  .glocket-features__card {
    flex: 0 0 220px;
    background: #f9f8f6;
    border-radius: 16px;
    padding: 28px 20px;
    text-align: center;
    scroll-snap-align: start;
    transition: box-shadow 0.2s;
  }

  .glocket-features__card:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
  }

  .glocket-features__card-icon {
    font-size: 40px;
    margin-bottom: 12px;
    display: block;
  }

  .glocket-features__card-title {
    font-size: 15px;
    font-weight: 700;
    color: #111;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .glocket-features__card-text {
    font-size: 13px;
    color: #666;
    line-height: 1.5;
    margin: 0;
  }

  /* Carousel nav dots */
  .glocket-features__dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 20px;
  }

  .glocket-features__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ddd;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: background 0.2s;
  }

  .glocket-features__dot.active { background: #111; }

  /* ── Certification badges strip ── */
  .glocket-features__badges {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid #eee;
  }

  .glocket-features__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .glocket-features__badge-icon {
    font-size: 28px;
  }

  .glocket-features__badge img {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .glocket-features__badge-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #555;
  }
</style>

<section class="glocket-features" id="glocket-features">
  <div class="glocket-features__inner">

    <div class="glocket-features__header">
      <h2 class="glocket-features__heading">{{ section.settings.heading }}</h2>
      <p class="glocket-features__subheading">{{ section.settings.subheading }}</p>
    </div>

    <div class="glocket-features__carousel-wrap">
      <div class="glocket-features__carousel" id="glocket-feature-carousel">

        <div class="glocket-features__card">
          <span class="glocket-features__card-icon">🔩</span>
          <h3 class="glocket-features__card-title">No Adhesive</h3>
          <p class="glocket-features__card-text">Zero sticky residue. Never damages your phone case or device.</p>
        </div>

        <div class="glocket-features__card">
          <span class="glocket-features__card-icon">💳</span>
          <h3 class="glocket-features__card-title">3-Card Capacity</h3>
          <p class="glocket-features__card-text">Credit cards, ID, transit pass — all in a secure, slim pocket.</p>
        </div>

        <div class="glocket-features__card">
          <span class="glocket-features__card-icon">📐</span>
          <h3 class="glocket-features__card-title">4mm Profile</h3>
          <p class="glocket-features__card-text">Thinner than a standard credit card. You won't even feel it.</p>
        </div>

        <div class="glocket-features__card">
          <span class="glocket-features__card-icon">💧</span>
          <h3 class="glocket-features__card-title">Washable Grip</h3>
          <p class="glocket-features__card-text">Rinse with warm water to restore full suction — good as new.</p>
        </div>

        <div class="glocket-features__card">
          <span class="glocket-features__card-icon">🏋️</span>
          <h3 class="glocket-features__card-title">Gym-Proof Hold</h3>
          <p class="glocket-features__card-text">Mounts securely to mirrors, equipment, and tiles at the gym.</p>
        </div>

        <div class="glocket-features__card">
          <span class="glocket-features__card-icon">🚗</span>
          <h3 class="glocket-features__card-title">Car Dashboard Ready</h3>
          <p class="glocket-features__card-text">Use as a phone mount on your car dashboard — no bracket needed.</p>
        </div>

        <div class="glocket-features__card">
          <span class="glocket-features__card-icon">🌱</span>
          <h3 class="glocket-features__card-title">Eco-Friendly</h3>
          <p class="glocket-features__card-text">Made from recyclable silicon. No single-use plastics or adhesives.</p>
        </div>

        <div class="glocket-features__card">
          <span class="glocket-features__card-icon">🎁</span>
          <h3 class="glocket-features__card-title">Perfect Gift</h3>
          <p class="glocket-features__card-text">Works for any phone model. A crowd-pleasing gift for anyone.</p>
        </div>

      </div>

      <div class="glocket-features__dots" id="glocket-feature-dots">
        <button class="glocket-features__dot active" data-index="0"></button>
        <button class="glocket-features__dot" data-index="1"></button>
        <button class="glocket-features__dot" data-index="2"></button>
        <button class="glocket-features__dot" data-index="3"></button>
      </div>
    </div>

    {%- comment -%} Certification/badge strip {%- endcomment -%}
    <div class="glocket-features__badges">
      <div class="glocket-features__badge">
        <span class="glocket-features__badge-icon">✅</span>
        <span class="glocket-features__badge-label">BPA Free</span>
      </div>
      <div class="glocket-features__badge">
        <span class="glocket-features__badge-icon">🌿</span>
        <span class="glocket-features__badge-label">Non-Toxic</span>
      </div>
      <div class="glocket-features__badge">
        <span class="glocket-features__badge-icon">♻️</span>
        <span class="glocket-features__badge-label">Recyclable</span>
      </div>
      <div class="glocket-features__badge">
        <span class="glocket-features__badge-icon">🔬</span>
        <span class="glocket-features__badge-label">Lab Tested</span>
      </div>
      <div class="glocket-features__badge">
        <span class="glocket-features__badge-icon">🛡️</span>
        <span class="glocket-features__badge-label">Quality Assured</span>
      </div>
    </div>

  </div>
</section>

<script>
(function() {
  var carousel = document.getElementById('glocket-feature-carousel');
  var dots = document.querySelectorAll('.glocket-features__dot');
  if (!carousel) return;

  function updateDots() {
    var cardWidth = carousel.querySelector('.glocket-features__card').offsetWidth + 20;
    var index = Math.round(carousel.scrollLeft / cardWidth);
    dots.forEach(function(d, i) { d.classList.toggle('active', i === index); });
  }

  carousel.addEventListener('scroll', updateDots, { passive: true });

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var cardWidth = carousel.querySelector('.glocket-features__card').offsetWidth + 20;
      carousel.scrollTo({ left: parseInt(this.dataset.index) * cardWidth * 2, behavior: 'smooth' });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Glocket Features",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Everything You Need. Nothing You Don't." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Glocket is engineered to simplify your carry without compromise." }
  ]
}
{% endschema %}
