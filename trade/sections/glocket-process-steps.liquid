{{ 'glocket-sections.css' | asset_url | stylesheet_tag }}

{% style %}
  #GlocketProcessSteps-{{ section.id }} {
    --glocket-pad-top: {{ section.settings.padding_top }}px;
    --glocket-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div
  id="GlocketProcessSteps-{{ section.id }}"
  class="glocket-section glocket-process-steps color-{{ section.settings.color_scheme }} gradient"
>
  <div class="glocket-section__inner">
    {% if section.settings.heading != blank %}
      <h2 class="glocket-heading glocket-process-steps__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="glocket-process-steps__items">
        {% for block in section.blocks %}
          <article class="glocket-process-steps__step" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="glocket-process-steps__media">
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'glocket-process-steps__image',
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    widths: '375, 550, 750, 1000'
                }}
              </div>
            {% endif %}
            <p class="glocket-process-steps__number" aria-hidden="true">{{ forloop.index }}</p>
            {% if block.settings.title != blank %}
              <h3 class="glocket-process-steps__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="glocket-process-steps__text rte">{{ block.settings.text }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Glocket process steps",
  "tag": "section",
  "class": "section-glocket-process-steps",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Simple from start to finish"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe what happens at this stage in one clear sentence.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glocket process steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
