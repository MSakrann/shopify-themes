{% comment %}
  GLOCKET — Benefits Grid Section
  Mirrors Vinia's "Benefits of Daily Consumption" 6-card grid.
{% endcomment %}

<style>
  .glocket-benefits {
    background: #f9f8f6;
    padding: 80px 20px;
  }

  .glocket-benefits__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .glocket-benefits__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .glocket-benefits__heading {
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 800;
    color: #111;
    margin: 0 0 12px;
    line-height: 1.15;
  }

  .glocket-benefits__subheading {
    font-size: 16px;
    color: #666;
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .glocket-benefits__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .glocket-benefits__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .glocket-benefits__grid {
      grid-template-columns: 1fr;
    }
  }

  .glocket-benefits__card {
    background: #fff;
    border-radius: 16px;
    padding: 28px 24px;
    border: 1px solid #eee;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .glocket-benefits__card:hover {
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    transform: translateY(-3px);
  }

  .glocket-benefits__card-icon {
    font-size: 32px;
    margin-bottom: 14px;
    display: block;
  }

  .glocket-benefits__card-title {
    font-size: 16px;
    font-weight: 700;
    color: #111;
    margin: 0 0 8px;
  }

  .glocket-benefits__card-text {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }
</style>

<section class="glocket-benefits" id="glocket-benefits">
  <div class="glocket-benefits__inner">

    <div class="glocket-benefits__header">
      <h2 class="glocket-benefits__heading">{{ section.settings.heading }}</h2>
      <p class="glocket-benefits__subheading">{{ section.settings.subheading }}</p>
    </div>

    <div class="glocket-benefits__grid">

      <div class="glocket-benefits__card">
        <span class="glocket-benefits__card-icon"></span>
        <h3 class="glocket-benefits__card-title">{{ section.settings.benefit_1_title }}</h3>
        <p class="glocket-benefits__card-text">{{ section.settings.benefit_1_text }}</p>
      </div>

      <div class="glocket-benefits__card">
        <span class="glocket-benefits__card-icon"></span>
        <h3 class="glocket-benefits__card-title">{{ section.settings.benefit_2_title }}</h3>
        <p class="glocket-benefits__card-text">{{ section.settings.benefit_2_text }}</p>
      </div>

      <div class="glocket-benefits__card">
        <span class="glocket-benefits__card-icon"></span>
        <h3 class="glocket-benefits__card-title">{{ section.settings.benefit_3_title }}</h3>
        <p class="glocket-benefits__card-text">{{ section.settings.benefit_3_text }}</p>
      </div>

      <div class="glocket-benefits__card">
        <span class="glocket-benefits__card-icon"></span>
        <h3 class="glocket-benefits__card-title">{{ section.settings.benefit_4_title }}</h3>
        <p class="glocket-benefits__card-text">{{ section.settings.benefit_4_text }}</p>
      </div>

      <div class="glocket-benefits__card">
        <span class="glocket-benefits__card-icon"></span>
        <h3 class="glocket-benefits__card-title">{{ section.settings.benefit_5_title }}</h3>
        <p class="glocket-benefits__card-text">{{ section.settings.benefit_5_text }}</p>
      </div>

      <div class="glocket-benefits__card">
        <span class="glocket-benefits__card-icon"></span>
        <h3 class="glocket-benefits__card-title">{{ section.settings.benefit_6_title }}</h3>
        <p class="glocket-benefits__card-text">{{ section.settings.benefit_6_text }}</p>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Glocket Benefits",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Glocket Changes Everything" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "One slim sleeve. Your phone case, wallet, and grip — all in one." },
    { "type": "text", "id": "benefit_1_title", "label": "Benefit 1 Title", "default": "Ultra-Strong Suction" },
    { "type": "textarea", "id": "benefit_1_text", "label": "Benefit 1 Text", "default": "Medical-grade silicon suction cups lock onto your phone and any smooth surface securely." },
    { "type": "text", "id": "benefit_2_title", "label": "Benefit 2 Title", "default": "Slim Card Compartment" },
    { "type": "textarea", "id": "benefit_2_text", "label": "Benefit 2 Text", "default": "Holds up to 3 cards — IDs, credit cards, access cards — always within reach." },
    { "type": "text", "id": "benefit_3_title", "label": "Benefit 3 Title", "default": "Universal Compatibility" },
    { "type": "textarea", "id": "benefit_3_text", "label": "Benefit 3 Text", "default": "Works with any smartphone and major phone cases. No installation required." },
    { "type": "text", "id": "benefit_4_title", "label": "Benefit 4 Title", "default": "Reusable & Washable" },
    { "type": "textarea", "id": "benefit_4_text", "label": "Benefit 4 Text", "default": "Rinse and restore suction. Glocket is built to last thousands of attach/detach cycles." },
    { "type": "text", "id": "benefit_5_title", "label": "Benefit 5 Title", "default": "Secure on Any Surface" },
    { "type": "textarea", "id": "benefit_5_text", "label": "Benefit 5 Text", "default": "Sticks to glass, marble, metal, tile, car dashboards, and more." },
    { "type": "text", "id": "benefit_6_title", "label": "Benefit 6 Title", "default": "Pocket-Friendly Profile" },
    { "type": "textarea", "id": "benefit_6_text", "label": "Benefit 6 Text", "default": "Just 4mm thin. Adds zero bulk while keeping your essentials on hand." }
  ]
}
{% endschema %}
