{{ 'nomad-sections.css' | asset_url | stylesheet_tag }}

{% style %}
  #NomadFaq-{{ section.id }} {
    --nomad-pad-top: {{ section.settings.padding_top }}px;
    --nomad-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div
  id="NomadFaq-{{ section.id }}"
  class="nomad-section nomad-faq color-{{ section.settings.color_scheme }} gradient"
>
  <div class="nomad-section__inner">
    <div class="nomad-card color-{{ section.settings.card_color_scheme }} nomad-faq__card">
      {% if section.settings.heading != blank %}
        <h2 class="nomad-heading nomad-faq__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="nomad-faq__accordion nomad-accordion">
          {% for block in section.blocks %}
            <div class="nomad-faq__item" {{ block.shopify_attributes }}>
              {% render 'nomad-accordion',
                heading: block.settings.question,
                content: block.settings.answer
              %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Nomad FAQ",
  "tag": "section",
  "class": "section-nomad-faq",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What cables does Glocket work with?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Glocket is sized for everyday USB-C, Lightning, and MagSafe cable tips so you can park the ones you use most.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nomad FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What cables does Glocket work with?",
            "answer": "<p>Glocket is sized for everyday USB-C, Lightning, and MagSafe cable tips so you can park the ones you use most.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Will it slide on a smooth desk?",
            "answer": "<p>The silicone base is designed to grip wood, glass, and painted surfaces under normal use. Keep the underside clean for the best hold.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I clean Glocket?",
            "answer": "<p>Wipe with a soft damp cloth and mild soap if needed. Avoid harsh solvents and do not put Glocket in the dishwasher.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is Glocket made for travel?",
            "answer": "<p>Yes. The compact shape packs easily for work bags and short trips so your cables stay ready wherever you charge.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>If Glocket is not the right fit, contact support within the return window listed on your order confirmation for a simple exchange or refund.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
