{% comment %}
  GLOCKET — Stats / Numbers Section
  Mirrors Vinia's "70% Increase in Arterial Dilation" bold stats block.
{% endcomment %}

<style>
  .glocket-stats {
    background: #111;
    color: #fff;
    padding: 80px 20px;
    text-align: center;
  }

  .glocket-stats__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .glocket-stats__heading {
    font-size: clamp(22px, 3vw, 34px);
    font-weight: 800;
    margin: 0 0 48px;
    color: #fff;
  }

  .glocket-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  @media (max-width: 700px) {
    .glocket-stats__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .glocket-stats__item {
    padding: 0 20px;
    position: relative;
  }

  .glocket-stats__item + .glocket-stats__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    height: 60%;
    width: 1px;
    background: rgba(255,255,255,0.15);
  }

  @media (max-width: 700px) {
    .glocket-stats__item + .glocket-stats__item::before { display: none; }
  }

  .glocket-stats__number {
    font-size: clamp(48px, 7vw, 80px);
    font-weight: 900;
    color: #fff;
    line-height: 1;
    margin-bottom: 10px;
    display: block;
  }

  .glocket-stats__label {
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #fff;
    margin-bottom: 12px;
  }

  .glocket-stats__desc {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    line-height: 1.6;
    max-width: 240px;
    margin: 0 auto;
  }

  .glocket-stats__cta {
    margin-top: 52px;
  }

  .glocket-stats__cta a {
    display: inline-block;
    padding: 14px 36px;
    background: #fff;
    color: #111;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }

  .glocket-stats__cta a:hover {
    background: #e0e0e0;
  }
</style>

<section class="glocket-stats" id="glocket-stats">
  <div class="glocket-stats__inner">

    <h2 class="glocket-stats__heading">{{ section.settings.heading }}</h2>

    <div class="glocket-stats__grid">

      <div class="glocket-stats__item">
        <span class="glocket-stats__number">{{ section.settings.stat_1_number }}</span>
        <div class="glocket-stats__label">{{ section.settings.stat_1_label }}</div>
        <p class="glocket-stats__desc">{{ section.settings.stat_1_desc }}</p>
      </div>

      <div class="glocket-stats__item">
        <span class="glocket-stats__number">{{ section.settings.stat_2_number }}</span>
        <div class="glocket-stats__label">{{ section.settings.stat_2_label }}</div>
        <p class="glocket-stats__desc">{{ section.settings.stat_2_desc }}</p>
      </div>

      <div class="glocket-stats__item">
        <span class="glocket-stats__number">{{ section.settings.stat_3_number }}</span>
        <div class="glocket-stats__label">{{ section.settings.stat_3_label }}</div>
        <p class="glocket-stats__desc">{{ section.settings.stat_3_desc }}</p>
      </div>

    </div>

    <div class="glocket-stats__cta">
      <a href="#glocket-hero">Get Your Glocket</a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Glocket Stats",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section Heading", "default": "Built for Real Life" },
    { "type": "text", "id": "stat_1_number", "label": "Stat 1 Number", "default": "3x" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 Label", "default": "Stronger Grip" },
    { "type": "textarea", "id": "stat_1_desc", "label": "Stat 1 Description", "default": "Glocket's silicon suction holds 3x stronger than adhesive-based alternatives" },
    { "type": "text", "id": "stat_2_number", "label": "Stat 2 Number", "default": "4mm" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 Label", "default": "Ultra Slim" },
    { "type": "textarea", "id": "stat_2_desc", "label": "Stat 2 Description", "default": "Adds only 4mm to your phone — thinner than a credit card" },
    { "type": "text", "id": "stat_3_number", "label": "Stat 3 Number", "default": "10K+" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 Label", "default": "Happy Customers" },
    { "type": "textarea", "id": "stat_3_desc", "label": "Stat 3 Description", "default": "Thousands of everyday users trust Glocket as their go-to phone accessory" }
  ]
}
{% endschema %}
