{{ 'nomad-sections.css' | asset_url | stylesheet_tag }}

{% style %}
  #NomadCrossSell-{{ section.id }} {
    --nomad-pad-top: {{ section.settings.padding_top }}px;
    --nomad-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<div
  id="NomadCrossSell-{{ section.id }}"
  class="nomad-section nomad-cross-sell color-{{ section.settings.color_scheme }} gradient"
>
  <div class="nomad-section__inner">
    {% if section.settings.heading != blank %}
      <h2 class="nomad-heading nomad-cross-sell__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="nomad-cross-sell__list" role="list">
        {% for block in section.blocks %}
          <li
            class="nomad-cross-sell__item nomad-card color-{{ section.settings.card_color_scheme }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a class="nomad-cross-sell__link" href="{{ block.settings.link }}">
            {% else %}
              <div class="nomad-cross-sell__link">
            {% endif %}
              <div class="nomad-cross-sell__media nomad-media">
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 320, 480, 640, 800',
                      sizes: '(min-width: 750px) 240px, 42vw'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
              {% if block.settings.title != blank %}
                <p class="nomad-cross-sell__title">{{ block.settings.title | escape }}</p>
              {% endif %}
              {% if block.settings.subtitle != blank %}
                <p class="nomad-cross-sell__subtitle">{{ block.settings.subtitle | escape }}</p>
              {% endif %}
              {% if block.settings.price_text != blank %}
                <p class="nomad-cross-sell__price">{{ block.settings.price_text | escape }}</p>
              {% endif %}
            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Nomad cross-sell",
  "tag": "section",
  "class": "section-nomad-cross-sell",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Keep Exploring"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Glocket desk dock"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Everyday kit"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price text",
          "default": "$49"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nomad cross-sell",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "title": "Glocket desk dock",
            "subtitle": "Everyday kit",
            "price_text": "$49"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Glocket travel pouch",
            "subtitle": "On the go",
            "price_text": "$29"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Glocket cable kit",
            "subtitle": "Bundle",
            "price_text": "$18"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Glocket wall mount",
            "subtitle": "Home setup",
            "price_text": "$36"
          }
        }
      ]
    }
  ]
}
{% endschema %}
